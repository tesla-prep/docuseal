<% if TwilioSms.configured? && !turbo_native_app? %>
  <div class="form-control">
    <%= f.label :send_sms, for: uuid = SecureRandom.uuid, class: 'flex items-center cursor-pointer' do %>
      <%= f.check_box :send_sms, id: uuid, class: 'base-checkbox', checked: !local_assigns.key?(:resend_sms) %>
      <span class="label"><%= local_assigns[:resend_sms] ? t('re_send_sms') : t('send_sms') %></span>
    <% end %>
    <% unless local_assigns.key?(:resend_sms) %>
      <%= f.label :require_phone_2fa, for: uuid = SecureRandom.uuid, class: 'flex items-center cursor-pointer' do %>
        <%= f.check_box :require_phone_2fa, id: uuid, class: 'base-checkbox', checked: false %>
        <span class="label"><%= t('require_phone_2fa') %></span>
      <% end %>
    <% end %>
  </div>
<% end %>
